{
  "bridge-text": "flex:none;font-size:15.5px;font-weight:700;color:#c3cace;letter-spacing:-.01em;text-align:center",
  "picker-rim": "box-sizing:border-box;border-radius:19px;padding:1px;background:linear-gradient(158deg,rgba(255,255,255,.48) 0%,rgba(91,155,247,.3) 38%,rgba(255,255,255,.09) 72%,rgba(255,255,255,.3) 100%);box-shadow:0 26px 58px rgba(3,8,16,.58),0 0 44px rgba(47,125,246,.12)",
  "picker-surface": "position:relative;border-radius:18px;overflow:hidden;padding:20px;background:linear-gradient(172deg,rgba(24,36,54,.94) 0%,rgba(14,22,34,.96) 46%,rgba(18,32,52,.95) 100%);box-shadow:inset 0 1px 0 rgba(255,255,255,.4),inset 0 -1px 0 rgba(255,255,255,.08)",
  "picker-edgelight": "position:absolute;left:-10%;right:-10%;top:0;height:38%;pointer-events:none;background:linear-gradient(180deg,rgba(255,255,255,.09),transparent)",
  "picker-header": "position:relative;display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:14px",
  "picker-select": "display:flex;align-items:center;justify-content:space-between;gap:8px;background:rgba(13,21,34,.8);border:1px solid {{ s.bd }};border-radius:9px;padding:9px 11px",
  "engine-chip": "background:rgba(47,125,246,.16);border:1px solid rgba(47,125,246,.34);border-radius:8px;color:#9dc2fa;padding:6px 11px;font-size:12.5px;font-weight:700",
  "vin-row": "position:relative;margin-top:14px;padding-top:14px;border-top:1px solid rgba(255,255,255,.09);display:flex;gap:8px;align-items:center",
  "vin-btn": "padding:9px 15px;border-radius:9px;background:#1b5fd9;font-size:13px;font-weight:800;color:#fff;flex:none",
  "sku-card": "display:flex;align-items:flex-start;gap:13px;background:linear-gradient(158deg,rgba(30,44,66,.92),rgba(16,26,42,.86));border:1px solid rgba(255,255,255,.15);border-radius:18px;padding:15px 17px;box-shadow:0 22px 46px rgba(3,8,16,.6),inset 0 1px 0 rgba(255,255,255,.16)",
  "sku-disc": "width:40px;height:40px;border-radius:50%;background:rgba(47,125,246,.22);border:1px solid rgba(47,125,246,.36);display:flex;align-items:center;justify-content:center;flex:none",
  "window-rim": "box-sizing:border-box;border-radius:19px;padding:1px;background:linear-gradient(158deg,rgba(255,255,255,.48) 0%,rgba(91,155,247,.3) 38%,rgba(255,255,255,.09) 72%,rgba(255,255,255,.3) 100%);box-shadow:0 34px 78px rgba(3,8,16,.66),0 0 56px rgba(47,125,246,.14)",
  "window-surface": "position:relative;border-radius:18px;overflow:hidden;background:linear-gradient(172deg,rgba(24,36,54,.94) 0%,rgba(14,22,34,.96) 46%,rgba(18,32,52,.95) 100%);box-shadow:inset 0 1px 0 rgba(255,255,255,.4),inset 0 -1px 0 rgba(255,255,255,.08)",
  "window-edgelight": "position:absolute;left:-10%;right:-10%;top:0;height:34%;pointer-events:none;background:linear-gradient(180deg,rgba(255,255,255,.09),transparent)",
  "window-bar": "position:relative;display:flex;align-items:center;gap:12px;padding:13px 17px;border-bottom:1px solid rgba(255,255,255,.1)",
  "window-query": "flex:1;min-width:0;display:flex;align-items:center;gap:8px;background:rgba(8,13,20,.6);border:1px solid rgba(255,255,255,.09);border-radius:8px;padding:6px 11px",
  "window-body": "position:relative;padding:18px 18px 22px",
  "result-counts": "display:flex;align-items:baseline;gap:12px;flex-wrap:wrap;font-variant-numeric:tabular-nums;margin-bottom:18px",
  "part-card": "min-width:0;background:linear-gradient(150deg,rgba(255,255,255,.075) 0%,rgba(255,255,255,.025) 100%);border:1px solid {{ c.bd }};border-radius:16px;overflow:hidden;display:flex;flex-direction:column;box-shadow:inset 0 1px 0 rgba(255,255,255,.18),0 16px 36px rgba(3,8,16,.42);opacity:{{ c.op }}",
  "part-plate": "position:relative;aspect-ratio:3/2;background:#0a1119;border-bottom:1px solid rgba(255,255,255,.07);display:flex;align-items:center;justify-content:center",
  "plate-blueprint": "position:absolute;inset:0;background-image:linear-gradient(rgba(47,125,246,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(47,125,246,.05) 1px,transparent 1px);background-size:16px 16px",
  "genuine-badge": "position:absolute;top:9px;left:9px;display:flex;align-items:center;gap:4px;background:rgba(245,158,11,.1);border:1px solid rgba(245,158,11,.28);border-radius:6px;padding:3px 6px",
  "card-info": "padding:13px 14px 15px;display:flex;flex-direction:column;gap:8px"
}