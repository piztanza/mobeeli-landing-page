# Canonical site origin for SEO metadata (metadataBase, canonical URLs, robots.txt,
# sitemap.xml — F-010). Defaults to https://mobeeli.com when unset.
NEXT_PUBLIC_SITE_URL=https://mobeeli.com

# Neon Postgres connection string (server-only — set in Vercel env vars, never in client bundles).
# Unset in local dev: waitlist leads append to .data/waitlist-leads.jsonl instead.
DATABASE_URL=

# Resend API key for waitlist lead notifications (server-only)
RESEND_API_KEY=

# Where waitlist lead alert emails are sent (founding team inbox)
WAITLIST_ALERT_TO=
