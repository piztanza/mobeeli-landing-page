# Canonical site origin for SEO metadata (metadataBase, canonical URLs, robots.txt,
# sitemap.xml — F-010). Defaults to https://mobeeli.com when unset.
NEXT_PUBLIC_SITE_URL=https://mobeeli.com

# Neon Postgres connection string (server-only — set in Vercel env vars, never in client bundles).
# Unset in local dev: waitlist leads append to .data/waitlist-leads.jsonl instead.
DATABASE_URL=

# Resend API key for waitlist lead notifications (server-only)
RESEND_API_KEY=

# Where waitlist lead alert emails are sent (founding team inbox)
WAITLIST_ALERT_TO=

# OPTIONAL — Resend Audience id for buyer "get notified" signups (F-015).
# Unset: /api/notify auto-discovers the audience, requiring EXACTLY one on the
# account (cached per server instance). Zero or multiple audiences → buyer
# addresses fall back to an alert email to WAITLIST_ALERT_TO; set this id to
# disambiguate. Contacts are tagged source=buyer_launch for the Buyers segment.
RESEND_AUDIENCE_ID=

# OPTIONAL — Notion logging for inbound leads (server-only). One integration secret
# covers both databases; each must be shared with that integration (Connections) or
# Notion answers 404. Unset (local dev) the logging is skipped and the email / Resend
# paths are unaffected.
#   NOTION_DECK_DB_ID    "Deck Requests"   — /investors deck requests
#   NOTION_BUYERS_DB_ID  "Buyer Signups"   — buyer-strip "get notified" signups
#   NOTION_SELLERS_DB_ID "Seller Waitlist" — /join wizard signups (a MIRROR of the
#                        partner_signups insert, written only after it succeeds)
NOTION_TOKEN=
NOTION_DECK_DB_ID=
NOTION_BUYERS_DB_ID=
NOTION_SELLERS_DB_ID=

# Signing key for investor deck links (F-016, server-only). Gates the founder-only
# /deck-admin page (?key=…) and HMAC-signs the stateless /deck?token=… links —
# use a long random string; rotating it invalidates every outstanding link.
# Must NOT contain "/" — mailed links come back with a click-tracking path appended
# and everything from the first slash is stripped before the comparison.
DECK_SECRET=
